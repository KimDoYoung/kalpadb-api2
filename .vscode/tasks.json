{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: build frontend",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "build:bundle"
      ],
      "isBackground": false,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^npm notice.*",
          "endsPattern": "^npm notice.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "gradle: build and run",
      "type": "shell",
      "command": "gradle",
      "args": [
        "bootRun"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Building.*",
          "endsPattern": "^.*Started.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    }
  ]
}
